FROM php:8.2-fpm-alpine

RUN apk add --no-cache bash nginx mariadb mariadb-client \
    && docker-php-ext-install pdo pdo_mysql \
    && mkdir -p /run/nginx /run/mysqld /var/lib/mysql /var/www/html \
    && chown -R mysql:mysql /run/mysqld /var/lib/mysql \
    && chown -R www-data:www-data /var/www/html

COPY build/config/php.ini /usr/local/etc/php/conf.d/ctf.ini
COPY build/config/nginx.conf /etc/nginx/http.d/default.conf
COPY build/src/ /var/www/html/
COPY build/service/start.sh /start.sh

RUN chmod 755 /start.sh \
    && chown -R www-data:www-data /var/www/html \
    && chmod -R 755 /var/www/html

EXPOSE 80

CMD ["/bin/sh", "/start.sh"]
